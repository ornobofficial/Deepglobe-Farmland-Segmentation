        m = metric_dict(tp, fp, fn, tn)

        for k, v in (("epoch", epoch), ("train_loss", train_loss),
                     ("val_loss", val_loss), ("val_iou", m["iou"]), ("val_f1", m["f1"])):
            history[k].append(v)

