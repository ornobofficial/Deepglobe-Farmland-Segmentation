        ckpt = {"epoch": epoch, "model": model.state_dict(), "opt": opt.state_dict(),
                "val_iou": m["iou"], "config": {"lr": LR, "batch": BATCH, "loss": "ce"}}
        torch.save(ckpt, OUT_DIR / f"{run_name}_ep{epoch:02d}.pth")
        if m["iou"] > best_iou:          # keep a separate copy of the best epoch
