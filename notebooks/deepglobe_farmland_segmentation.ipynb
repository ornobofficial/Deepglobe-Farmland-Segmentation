# Step 2: MNIST training loop on GPU (sanity check of the 5 steps)
import torch, torch.nn as nn
from torchvision import datasets, transforms
from torch.utils.data import DataLoader

device = "cuda"                                   # use the GPU

tf = transforms.ToTensor()                        # image -> tensor (0..1)
train = datasets.MNIST("/kaggle/working", train=True,  download=True, transform=tf)
test  = datasets.MNIST("/kaggle/working", train=False, download=True, transform=tf)
train_loader = DataLoader(train, batch_size=64, shuffle=True)   # feeds data in batches
test_loader  = DataLoader(test,  batch_size=256)

model = nn.Sequential(nn.Flatten(), nn.Linear(784,128), nn.ReLU(), nn.Linear(128,10)).to(device)
loss_fn = nn.CrossEntropyLoss()                   # the "how wrong" score
opt = torch.optim.Adam(model.parameters(), lr=1e-3)  # turns the knobs

for epoch in range(3):
    for x, y in train_loader:
        x, y = x.to(device), y.to(device)         # move batch to GPU
        pred = model(x)                           # 1. forward pass
        loss = loss_fn(pred, y)                   # 2. loss
        opt.zero_grad()                           # clear old gradients
        loss.backward()                           # 3. backpropagation
        opt.step()                                # 4. update weights
    # evaluate on unseen test data
    correct = 0
    with torch.no_grad():                         # no gradients needed for testing
        for x, y in test_loader:
            x, y = x.to(device), y.to(device)
            correct += (model(x).argmax(1) == y).sum().item()
    print(f"epoch {epoch+1} | last train loss {loss.item():.4f} | test acc {correct/len(test):.4f}")


